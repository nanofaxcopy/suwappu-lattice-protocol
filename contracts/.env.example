# Environment for scripts/bridge_live.py and the Foundry deploy scripts.
#   cp contracts/.env.example contracts/.env
# NEVER commit the filled-in copy.

# ── SUWAPPU-chain leg ───────────────────────────────────────────────────
# NOTE: the original SUWAPPU testnet (chain 103115120) RPC endpoint is
# currently offline — see docs/DEPLOYED_CONTRACTS.md. These values must
# point at whatever chain replaces it (the suwappu-dag testnet once live).
SUWAPPU_RPC_URL=http://REPLACE_SUWAPPU_RPC:8545
SUWAPPU_ANCHOR_REGISTRY=0xREPLACE_REGISTRY_PROXY
SUWAPPU_OPERATOR_KEY=0xREPLACE_OPERATOR_PRIVATE_KEY

# ── Base Sepolia leg (live — addresses in docs/DEPLOYED_CONTRACTS.md) ───
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
L2_PROXY_ADDRESS=0x79eF9Ba43a09814f1d6642b131840B26af9c5996
L2_DEPLOYER_KEY=0xREPLACE_DEPLOYER_PRIVATE_KEY

# Used by deploy scripts (see contracts/script/*.s.sol for per-script vars):
#SUWAPPU_OPERATOR_ADDRESS=0xREPLACE_SECOND_MULTISIG_OWNER
#BRIDGE_TIMELOCK_ADMIN=0xREPLACE_TIMELOCK_ADMIN
#ALLOW_TESTNET_DEPLOY=true
