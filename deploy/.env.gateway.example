# Gateway VM environment — copy to deploy/.env.gateway and fill in.
#   cp deploy/.env.gateway.example deploy/.env.gateway
# Referenced by deploy/run_gateway.sh; validated by deploy/preflight_gateway.py.
# NEVER commit the filled-in copy (.gitignore covers .env.* except *.example).

# ── Required ────────────────────────────────────────────────────────────
# Source chain: where BridgeTransfer events are emitted (BridgeEmitter).
ETP_GATEWAY_VM_SOURCE_RPC_URL=https://sepolia.base.org
ETP_GATEWAY_VM_SOURCE_BRIDGE_CONTRACT=0xREPLACE_BRIDGE_EMITTER_ADDRESS

# Destination chain: where attestations are anchored (LTPAnchorRegistry proxy).
# Known registries are recorded in docs/DEPLOYED_CONTRACTS.md.
ETP_GATEWAY_VM_DEST_RPC_URL=https://REPLACE_DEST_RPC
ETP_GATEWAY_VM_DEST_REGISTRY=0xREPLACE_REGISTRY_PROXY_ADDRESS

# EOA that pays gas for anchor transactions (0x + 64 hex chars).
# Keep funded above 0.01 ETH (docs/OPERATOR_RUNBOOK.md, bridge-stuck triage).
ETP_GATEWAY_VM_OPERATOR_KEY=0xREPLACE_OPERATOR_PRIVATE_KEY

# ── Optional (defaults in src/ltp/gateway_vm/config.py) ─────────────────
#ETP_GATEWAY_VM_SOURCE_CHAIN_ID=84532
#ETP_GATEWAY_VM_DEST_CHAIN_ID=103115120
# ML-DSA gateway signing keypair. If unset, a fresh keypair is generated at
# boot — its vkHash will NOT be registered on-chain and every anchor will
# revert. Generate once, register via contracts/script/RegisterGatewaySigner.s.sol,
# and mount it (docker-compose.gateway.yml mounts ./gateway_keypair.json).
#ETP_GATEWAY_VM_KEYPAIR_PATH=/app/gateway_keypair.json
#ETP_GATEWAY_VM_FINALITY_DEPTH=2
#ETP_GATEWAY_VM_CHALLENGE_MODE=false
#ETP_GATEWAY_VM_POLL_INTERVAL=5
#ETP_GATEWAY_VM_METRICS_PORT=9109
