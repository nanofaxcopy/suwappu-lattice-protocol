// Entanglement Transfer Protocol (ETP, now LTP) — Formal Protocol Model
// Verifpal analysis of the 3-phase COMMIT / LATTICE / MATERIALIZE protocol
//
// Models an active attacker with unbounded sessions.
// ML-KEM-768 is modeled as DH key exchange (semantically equivalent
// for confidentiality analysis under symbolic model).
//
// Author: Suwappu-Labs
// Date: 2026-03-29
// Revised: 2026-08-16 — first actual verification run (Verifpal 0.27.4).
//
// The 2026-03-29 model was written but never run; it did not pass
// Verifpal's model checks. Changes made to obtain a runnable model,
// preserving the original's protocol intent (each is a modeling fix,
// not a protocol change — see ANALYSIS.md for the full discussion):
//
//   1. The Phase 1 message resent sender_vk, which Verifpal rejects
//      ("receiving constant despite already knowing it"). Dropped.
//   2. The pre-protocol identity-key exchange is now guarded ([...]):
//      identity keys are distributed authentically (key directory /
//      out-of-band verification), which is what ANALYSIS.md's
//      interpretation ("only the intended receiver") already assumed.
//      Unguarded, the unauthenticated DH exchange is trivially
//      MITM-able and every query fails for that uninteresting reason.
//   3. The Receiver used cek, entity_nonce, and encrypted_shards it had
//      never received. The commitment publication now carries
//      encrypted_shards and entity_nonce (both public: commitment nodes
//      are untrusted for confidentiality, and AEAD nonces are public),
//      and the Receiver recovers the CEK from the unsealed lattice
//      payload via SPLIT instead of using the Sender's secret directly.

attacker[active]

// === Key Setup ===

principal Sender[
	knows private sender_sk
	sender_vk = G^sender_sk
	generates content, cek, entity_nonce
]

principal Receiver[
	knows private receiver_sk
	receiver_ek = G^receiver_sk
]

// Public key exchange (pre-protocol). Guarded: identity keys are
// distributed authentically (key directory), per ANALYSIS.md.
Sender -> Receiver: [sender_vk]
Receiver -> Sender: [receiver_ek]

// === Phase 1: COMMIT ===
// Sender erasure-codes content, encrypts shards with CEK,
// distributes to commitment nodes, signs commitment record.

principal Sender[
	// Entity identity (content-addressed)
	entity_id = HASH(content)

	// Encrypt shards with CEK (AEAD)
	encrypted_shards = AEAD_ENC(cek, content, entity_nonce)

	// Commitment record: signed Merkle root of encrypted shards
	shard_root = HASH(encrypted_shards)
	commitment = SIGN(sender_sk, HASH(CONCAT(entity_id, shard_root)))
]

// Commitment is published (nodes store encrypted shards). The encrypted
// shards and the AEAD nonce are public: commitment nodes are untrusted
// for confidentiality, so the attacker sees both.
Sender -> Receiver: entity_id, shard_root, commitment, encrypted_shards, entity_nonce

// === Phase 2: LATTICE ===
// Sender seals CEK + entity_id to receiver via KEM (modeled as DH)

principal Sender[
	// Derive shared secret (models ML-KEM-768 encapsulation)
	shared_secret = receiver_ek^sender_sk

	// Seal the lattice key: CEK + entity_id + commitment ref
	lattice_payload = CONCAT(cek, entity_id)
	sealed_key = AEAD_ENC(shared_secret, lattice_payload, entity_nonce)
]

Sender -> Receiver: sealed_key

// === Phase 3: MATERIALIZE ===
// Receiver unseals, verifies commitment, fetches shards, reconstructs

principal Receiver[
	// Derive shared secret (models ML-KEM-768 decapsulation)
	shared_secret_r = sender_vk^receiver_sk

	// Unseal the lattice key
	lattice_payload_r = AEAD_DEC(shared_secret_r, sealed_key, entity_nonce)?

	// Recover the CEK and entity id from the lattice payload
	cek_r, entity_id_r = SPLIT(lattice_payload_r)?

	// Verify commitment signature
	commitment_valid = SIGNVERIF(sender_vk, HASH(CONCAT(entity_id, shard_root)), commitment)?

	// Decrypt shards with CEK (extracted from lattice payload)
	reconstructed = AEAD_DEC(cek_r, encrypted_shards, entity_nonce)?
]

// === Security Queries ===

queries[
	// Confidentiality: CEK must never be known to attacker
	confidentiality? cek

	// Confidentiality: Content must never be known to attacker
	confidentiality? content

	// Authentication: Commitment must be from Sender
	authentication? Sender -> Receiver: commitment

	// Authentication: Sealed key must be from Sender
	authentication? Sender -> Receiver: sealed_key
]
